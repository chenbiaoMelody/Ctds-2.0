# 构建产物
node_modules/
dist/
build/
target/
out/
coverage/

# 运行期日志与审计文件（不入库；部署侧统一采集）
# 红线例外：docs/logs/ 是开发日志目录，必须随任务分支入库（AGENTS.md 1.4）——**/logs/ 不得命中它
**/logs/
!docs/logs/
*.log

# 环境与密钥（红线：任何密钥不入库）
.env
.env.*
*.key
*.pem
*.p12
*.pfx
secrets*
# 国密组件密钥文件约定命名（WBS 2.4.6 B10：LocalFileKeyProvider 密钥文件建议用 *.keys 命名并被拦截）
*.keys
*keys*.properties
*keyfile*

# 系统与编辑器
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/

# 临时文件
*.tmp
*.bak

# 门禁运行报告（本地产物，不入库）
scripts/gates/reports/

# Nightly build output (WBS 2.2.6, ADR-012; local artifacts, not committed)
build-output/
