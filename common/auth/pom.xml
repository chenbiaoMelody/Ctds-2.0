<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ctds</groupId>
    <artifactId>ctds-platform</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>common-auth</artifactId>
  <name>common-auth</name>
  <description>公共组件：统一认证/授权框架（RBAC 接口、Token 校验；WBS 2.4.5，契约见 ADR-005 §3 第 7 项，设计定稿 docs/designs/WBS-2.4.5-hifi.md）</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.ctds</groupId>
      <artifactId>common-errorcode</artifactId>
    </dependency>
    <dependency>
      <groupId>com.ctds</groupId>
      <artifactId>common-logging</artifactId>
    </dependency>
    <!-- 网关侧 JWT 校验依赖：optional 使 Spring Security 不上普通服务 classpath（防 Boot 默认安全策略接管），
         网关服务（3.5.2）显式引入后配合 ctds.auth.gateway.enabled 生效。版本由 Boot 3.5.16 BOM 管理。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- 反应式类型（Mono/WebFilter 适配）编译所需；网关应用经 spring-boot-starter-webflux 自带 reactor。 -->
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-core</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 反应式链装配测试需要 webflux 类型（ServerHttpSecurity.build 的 exceptionHandling 依赖）；
         test scope 不传递给任何使用方，网关应用自带。 -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webflux</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
