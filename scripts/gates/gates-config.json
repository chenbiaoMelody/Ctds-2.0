{
  "version": "V1.0",
  "note": "C-TDS quality gate config. Consumed by scripts/gates/run-gates.ps1. Thresholds come from charter 4.2 table.",
  "thresholds": {
    "coreLineCoverage": 80,
    "overallLineCoverage": 70,
    "mutationKillRate": 60,
    "maxCyclomaticComplexity": 15,
    "maxNewDuplicatedLines": 0
  },
  "coreModules": ["policy-engine", "metering-billing", "crypto", "auth", "did"],
  "toolchain": {
    "javaHome": "C:\\Program Files\\Java\\jdk-17",
    "mavenBin": "mvn",
    "mavenArgs": "-B -ntp"
  },
  "stages": {
    "secretsScan": { "enabled": true, "mode": "builtin-regex", "ciTool": "gitleaks (pending whitelist admission, docs/04 §2.3)" },
    "structureCheck": { "enabled": true },
    "devLogNamingCheck": { "enabled": true },
    "adrFieldsCheck": {
      "enabled": true,
      "requiredFields": ["背景", "决策", "理由", "备选", "业务影响说明", "影响范围", "可替换性"]
    },
    "compile": { "enabled": true, "tool": "maven", "goals": "compile" },
    "lint": { "enabled": true, "tool": "checkstyle", "goals": "checkstyle:check" },
    "unitTest": { "enabled": true, "tool": "junit5+archunit", "goals": "test" },
    "frontendLint": { "enabled": true, "tool": "npm", "goals": "run lint", "workdir": "frontend" },
    "frontendTest": { "enabled": true, "tool": "npm", "goals": "run test", "workdir": "frontend" },
    "frontendE2E": { "enabled": false, "status": "PENDING-CI", "tool": "playwright", "goals": "run e2e", "workdir": "frontend", "note": "WBS-2.4.12: CI 环境浏览器二进制供给待 2.5.x 部署基建评估；本机可 npm run e2e 手动全量" },
    "coverage": { "enabled": false, "status": "PENDING-JACOCO", "tool": "jacoco" },
    "mutationTest": { "enabled": false, "status": "PENDING-TOOLCHAIN", "tool": "pitest" },
    "duplication": { "enabled": false, "status": "PENDING-TOOLCHAIN", "tool": "pmd-cpd" },
    "complexity": { "enabled": false, "status": "PENDING-TOOLCHAIN", "tool": "sonarqube" },
    "sast": { "enabled": false, "status": "PENDING-TOOLCHAIN", "tool": "semgrep" },
    "dependencyScan": { "enabled": false, "status": "PENDING-TOOLCHAIN", "tool": "owasp-dependency-check" },
    "moduleDependency": { "enabled": false, "status": "PENDING-TOOLCHAIN", "tool": "archunit-crossmodule" }
  },
  "secretsPatterns": [
    "-----BEGIN (RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----",
    "AKIA[0-9A-Z]{16}",
    "sk-[a-zA-Z0-9]{20,}",
    "xox[baprs]-[0-9A-Za-z-]{10,}",
    "(?i)(api[_-]?key|secret[_-]?key|access[_-]?token|private[_-]?key)\\s*[:=]\\s*['\"][A-Za-z0-9+/=_-]{16,}['\"]",
    "(?i)(password|passwd|pwd)\\s*[:=]\\s*['\"][^'\"\\s]{8,}['\"]"
  ],
  "secretsExcludePaths": [".git", "scripts/gates/reports", "build-output", "*.min.js", "*.lock", "node_modules"]
}
