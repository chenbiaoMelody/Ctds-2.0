<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ctds</groupId>
    <artifactId>ctds-platform</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>catalog-service</artifactId>
  <name>catalog-service</name>
  <description>目录与资源服务：资源登记模型与登记/变更/注销服务（WBS 3.3.2，设计定稿 docs/designs/WBS-3.3.2-hifi.md——元数据采集归 3.3.3、检索订阅归 3.3.4、产品封装上下架归 3.3.5、界面归 3.3.6，本服务为 3.3.2~3.3.5 共用宿主）</description>

  <dependencies>
    <!-- 平台组件（版本走父 BOM，非第三方新增依赖） -->
    <dependency>
      <groupId>com.ctds</groupId>
      <artifactId>common-errorcode</artifactId>
    </dependency>
    <dependency>
      <groupId>com.ctds</groupId>
      <artifactId>common-auth</artifactId>
    </dependency>
    <!-- 登记防重复提交（ADR-007 模式 B）：@Idempotent(key=空间+主体+归一化名) -->
    <dependency>
      <groupId>com.ctds</groupId>
      <artifactId>common-idempotency</artifactId>
    </dependency>
    <!-- 本人资源列表分页（ADR-005 §3.2）：复用 common-pagination -->
    <dependency>
      <groupId>com.ctds</groupId>
      <artifactId>common-pagination</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- 注销二次确认/要素校验通道（WBS-3.3.2 hifi §1） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- 数据库迁移工具链（WBS 2.4.10 / ADR-009）：默认 profile 不装载数据源，mysql profile 才启用 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 集成测试容器化基座（WBS 2.4.11 / ADR-010）：版本走 Boot BOM，全 test scope 不进业务制品 -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
